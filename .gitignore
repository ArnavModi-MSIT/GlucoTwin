# Publish only explicitly approved project files and directories.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/pyproject.toml
!/DATA_CONTRACT.md
!/EVALUATION_PROTOCOL.md
!/download_cgmacros.py
!/src/
!/scripts/
!/tests/
!/configs/
!/reports/
!/docs/

# Only non-record-level configuration and aggregate reports are public.
/configs/*
!/configs/model_selection.json
/reports/*
!/reports/CGMACROS_AUDIT.md
!/reports/BASELINE_RESULTS.md
!/reports/BOOSTING_RESULTS.md
!/reports/baseline_validation.json
!/reports/boosting_validation.json
!/reports/feature_preparation.json
!/reports/forecast_error_analysis.json

# Secrets, environments, caches, local files and generated model/data artifacts.
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/kaggle.json
**/*.pem
**/*.key
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/node_modules/
**/.DS_Store
**/Thumbs.db
**/*.joblib
**/*.pkl
**/*.pickle
**/*.zip
**/*.log
**/*.tmp
**/*.bak
